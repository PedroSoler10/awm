<?xml version="1.0"?>
<!--
  Single entry point for the AWM project: robot (Gazebo simulation or real
  TurtleBot3), SLAM, navigation, RViz and the `brain` node.

  mode picks how brain chooses its goals:
    standalone  brain searches the nearest unmeasured cell itself (default)
    modular     map_processing (/safe_map) and points_identification (/goal_points) also start,
                and brain asks /goal_points (in goal_mode) for each goal

  Every module can be switched on or off, so a subset can be started with one
  command, for example:
    roslaunch awm awm.launch                          full simulation
    roslaunch awm awm.launch brain:=false rviz:=false simulation, no brain and no RViz
    roslaunch awm awm.launch sim:=false               real robot, run on the robot
    roslaunch awm awm.launch mode:=modular            goals from the /goal_points service
  See the README for the full list of arguments.
-->
<launch>
  <!-- Robot -->
  <arg name="sim" default="true" doc="true: Gazebo simulation, false: real TurtleBot3 (bringup runs on this machine)"/>
  <arg name="model" default="$(optenv TURTLEBOT3_MODEL waffle)" doc="model type [burger, waffle, waffle_pi]. TURTLEBOT3_MODEL must also be set to the same value"/>

  <!-- Simulation only -->
  <arg name="world" default="turtlebot3_world" doc="world from turtlebot3_gazebo/worlds, without the .world extension"/>
  <arg name="gui" default="true" doc="show the Gazebo window"/>
  <arg name="x_pos" default="-2.0" doc="robot spawn position in the world, in meters"/>
  <arg name="y_pos" default="-0.5" doc="robot spawn position in the world, in meters"/>
  <arg name="z_pos" default="0.0" doc="robot spawn position in the world, in meters"/>

  <!-- Modules -->
  <arg name="slam" default="true" doc="run SLAM"/>
  <arg name="slam_method" default="gmapping" doc="SLAM method [gmapping, cartographer, hector, karto, frontier_exploration]"/>
  <arg name="nav" default="true" doc="run move_base (SLAM provides the localization)"/>
  <arg name="move_forward_only" default="false" doc="navigation never reverses the robot"/>
  <arg name="goal_xy_tolerance" default="0.10" doc="distance in meters at which move_base counts a goal as reached (TurtleBot3 default 0.05)"/>
  <arg name="goal_yaw_tolerance" default="3.15" doc="heading error in radians accepted at the goal; 3.15 ignores the heading, as measuring does not need one (TurtleBot3 default 0.17)"/>
  <arg name="rviz" default="true" doc="open RViz"/>
  <arg name="rviz_config" default="$(find awm)/rviz/awm.rviz" doc="RViz configuration file (awm.rviz: TurtleBot3 navigation view plus /safe_map and /measure_map)"/>
  <arg name="brain" default="true" doc="run the awm brain node"/>
  <arg name="mode" default="standalone" doc="how brain chooses goals [standalone, modular]"/>
  <arg name="goal_mode" default="3" doc="modular only: mode asked from /goal_points [1 EXPLORATION, 2 MEASUREMENT, 3 FUSION]"/>

  <!-- Gazebo, the robot model and its spawn -->
  <group if="$(arg sim)">
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
      <arg name="world_name" value="$(find turtlebot3_gazebo)/worlds/$(arg world).world"/>
      <arg name="paused" value="false"/>
      <arg name="use_sim_time" value="true"/>
      <arg name="gui" value="$(arg gui)"/>
      <arg name="headless" value="false"/>
      <arg name="debug" value="false"/>
    </include>

    <!-- Robot description and TF tree -->
    <include file="$(find turtlebot3_bringup)/launch/turtlebot3_remote.launch">
      <arg name="model" value="$(arg model)"/>
    </include>

    <node pkg="gazebo_ros" type="spawn_model" name="spawn_urdf"
          args="-urdf -model turtlebot3_$(arg model) -x $(arg x_pos) -y $(arg y_pos) -z $(arg z_pos) -param robot_description"/>
  </group>

  <!-- Real robot drivers, lidar and TF tree -->
  <group unless="$(arg sim)">
    <include file="$(find turtlebot3_bringup)/launch/turtlebot3_robot.launch"/>
  </group>

  <!-- SLAM -->
  <group if="$(arg slam)">
    <include file="$(find turtlebot3_slam)/launch/turtlebot3_$(arg slam_method).launch">
      <arg name="model" value="$(arg model)"/>
    </include>
  </group>

  <!-- Navigation. No AMCL: SLAM already publishes map -> odom, and AMCL would wait for a
       static_map service that gmapping does not serve. -->
  <group if="$(arg nav)">
    <include file="$(find turtlebot3_navigation)/launch/move_base.launch">
      <arg name="model" value="$(arg model)"/>
      <arg name="move_forward_only" value="$(arg move_forward_only)"/>
    </include>
    <!-- Relaxed goal: tight tolerances made the robot back up to re-approach close goals. Set after
         the include, so they override the TurtleBot3 DWA parameters. -->
    <param name="move_base/DWAPlannerROS/xy_goal_tolerance" value="$(arg goal_xy_tolerance)"/>
    <param name="move_base/DWAPlannerROS/yaw_goal_tolerance" value="$(arg goal_yaw_tolerance)"/>
  </group>

  <!-- RViz -->
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(arg rviz_config)"/>

  <!-- AWM. The lookup fails the launch for an unknown mode. -->
  <node if="$(arg brain)" pkg="awm" type="brain" name="brain" output="screen">
    <param name="goal_source" value="$(eval {'standalone': 'internal', 'modular': 'service'}[mode])"/>
    <param name="goal_mode" value="$(arg goal_mode)"/>
  </node>

  <group if="$(eval mode == 'modular')">
    <node pkg="awm" type="map_processing" name="map_processing" output="screen"/>
    <node pkg="awm" type="points_identification" name="points_identification" output="screen"/>
  </group>
</launch>
